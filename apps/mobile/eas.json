{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000",
        "EXPO_PUBLIC_WEB_URL": "http://localhost:3000",
        "COREPACK_INTEGRITY_KEYS": "0"
      },
      "corepack": true
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ekklesiabackend-bay.vercel.app",
        "EXPO_PUBLIC_WEB_URL": "https://ekklesia-web-indol.vercel.app",
        "COREPACK_INTEGRITY_KEYS": "0"
      },
      "corepack": true,
      "node": "22.14.0"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ekklesiabackend-bay.vercel.app",
        "EXPO_PUBLIC_WEB_URL": "https://ekklesia-web-indol.vercel.app",
        "COREPACK_INTEGRITY_KEYS": "0"
      },
      "corepack": true,
      "node": "22.14.0",
      "ios": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {}
  }
}