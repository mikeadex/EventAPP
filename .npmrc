# pnpm 11 supply-chain policy.
# 0 = no minimum age. Tighten later (e.g. 86400 for 1 day) once the project
# stabilises and we're vetting third-party updates more deliberately.
minimum-release-age=0

# Hoist Nest/Expo peer deps so workspace packages resolve them cleanly.
auto-install-peers=true
strict-peer-dependencies=false

# React Native / Expo tooling cannot follow pnpm's default isolated
# (symlinked) node_modules. EAS Build fails to resolve config plugins with
# "Failed to resolve plugin for module 'expo-router' ... Do you have node
# modules installed?", because the plugin resolver does not traverse the
# .pnpm store symlinks. Hoisted linking produces an npm-style flat tree that
# both EAS and Metro handle natively.
node-linker=hoisted
