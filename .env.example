# ---- Shared ----
NODE_ENV=development

# ---- API (apps/api) ----
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
MOBILE_DEEPLINK_SCHEME=ekklesia

DATABASE_URL=postgresql://ekklesia:ekklesia@localhost:5432/ekklesia?schema=public

# Better Auth
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081

# Stripe Connect
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
PLATFORM_FEE_BPS=500

# Object storage (S3-compatible). Leave *_KEY/SECRET blank to disable uploads
# in dev — POST /v1/uploads/sign will then return 503 and the web form shows
# a graceful "configure MinIO" fallback.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=ekklesia-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL browsers use to load uploaded files. For MinIO this is
# usually the same as S3_ENDPOINT; for real S3 with CloudFront, the CDN host.
S3_PUBLIC_BASE=http://localhost:9000

# Email (Resend). Leave RESEND_API_KEY blank to log emails instead of sending.
EMAIL_FROM="Ekklesia <no-reply@ekklesia.app>"
RESEND_API_KEY=

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ---- Mobile (apps/mobile) ----
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
