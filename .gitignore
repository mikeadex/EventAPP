# Expo continuous-native-generation: the native projects are generated from
# app.json + config plugins by `expo prebuild` / `expo run:*`, so we don't
# commit them. Re-generate anytime with `pnpm --filter @ekklesia/mobile exec expo prebuild`.
apps/mobile/ios
apps/mobile/android

# (kept for any non-CNG native dirs)
ios/Pods
ios/build
android/.gradle
android/build
android/app/build
.vercel
.env*.local

# This is a pnpm workspace. A stray package-lock.json makes
# @expo/package-manager resolve npm before pnpm (RESOLUTION_ORDER puts npm
# first), so EAS runs `npm install`, which ignores pnpm-workspace.yaml and
# never installs the app dependencies.
package-lock.json
